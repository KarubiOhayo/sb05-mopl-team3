{
  "title": "K6 MOPL Socket - 스테이징",
  "uid": "k6-mopl-socket-stg",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "WS 연결 수 (k6 connect rate)",
      "description": "k6가 생성한 WebSocket 연결 시도율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_k6_ws_connects_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "WS 연결 오류율 (k6)",
      "description": "k6 WebSocket 연결 실패율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_k6_ws_connect_errors_total[1m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 8
      }
    },
