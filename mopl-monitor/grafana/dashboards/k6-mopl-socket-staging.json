    {
      "type": "timeseries",
      "title": "시청 세션 조회 지연 p95/p99 (k6)",
      "description": "watching-sessions REST API의 p95/p99 지연(ms)입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(k6_http_req_duration_p95{name=~\"watching_sessions_.*\"}) * 1000) or (histogram_quantile(0.95, sum by (le, name) (rate(k6_http_req_duration_seconds_bucket{name=~\"watching_sessions_.*\"}[1m]))) * 1000)",
          "legendFormat": "{{name}} p95"
        },
        {
          "refId": "B",
          "expr": "(max(k6_http_req_duration_p99{name=~\"watching_sessions_.*\"}) * 1000) or (histogram_quantile(0.99, sum by (le, name) (rate(k6_http_req_duration_seconds_bucket{name=~\"watching_sessions_.*\"}[1m]))) * 1000)",
          "legendFormat": "{{name}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
