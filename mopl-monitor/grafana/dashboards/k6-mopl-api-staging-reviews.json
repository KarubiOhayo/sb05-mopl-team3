{
  "title": "K6 MOPL API - 스테이징 (Reviews)",
  "uid": "k6-mopl-api-stg-reviews",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "리뷰 조회 RPS",
      "description": "reviews_list 태그 기준 HTTP 요청 처리량입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"k6_http_reqs(_total)?\", name=\"reviews_list\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "리뷰 조회 지연 p99 (ms)",
      "description": "reviews_list 태그 기준 요청 지연 p99 입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_duration_p99{name=\"reviews_list\"}) * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "리뷰 조회 HTTP 실패율",
      "description": "reviews_list 태그 기준 HTTP 실패율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_failed_rate{name=\"reviews_list\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "가상 사용자 수 (VUs)",
      "description": "리뷰 조회 테스트 실행 중 VU 수입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_vus"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "리뷰 조회 지연 p95 (ms)",
      "description": "reviews_list 태그 기준 요청 지연 p95 입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-pens9053-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(k6_http_req_duration_p95{name=\"reviews_list\"}) * 1000) or (histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket{name=\"reviews_list\"}[1m]))) * 1000)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      }
    }
  ]
}
